<aura:component implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,force:hasRecordId,force:lightningQuickAction" access="global" >
    <aura:attribute name="FirstName" type="String"/>
        <aura:attribute name="LasttName" type="String"/> 
        <aura:attribute name="DOB" type="date"/>     
    <div>
        <lightning:input  name="First Name" label="First Name" value="{!v.FirstName}"/>
        <lightning:input  name="Last Name" label="Last Name" value="{!v.LasttName}" />
        <lightning:input  name="DOB" label="DOB" value="{!v.DOB}" />
    </div>
    <div>
    <lightning:button variant="brand" label="Submit" title="Submit" onclick="{! c.handleClick }" />
    </div>
</aura:component>